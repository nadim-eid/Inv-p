{
  "name": "chemical-stock-manager-frontend",
  "version": "2.0.0",
  "description": "Frontend PWA (React + Vite) pour Chemical Stock Manager - sans dependance Microsoft",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "android:add": "vite build && npx cap add android",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
