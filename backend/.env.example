# ============================================================
# Chemical Stock Manager - Backend - Variables d'environnement
# ============================================================
# Copier ce fichier en ".env" et remplir les valeurs reelles.
# Ne JAMAIS committer le fichier ".env" dans Git.
#
# Cette version NE DEPEND D'AUCUN SERVICE MICROSOFT : les donnees sont
# stockees localement (fichiers JSON sur disque, voir DATA_DIR) et les
# comptes utilisateurs sont geres par l'application elle-meme (pas
# d'Entra ID / Azure AD).

# ----- Serveur -----
PORT=4000
NODE_ENV=development
# Origine(s) autorisee(s) pour le frontend (CORS), separees par des virgules
CORS_ORIGIN=https://localhost:5173

# ----- Authentification locale -----
# Cle secrete utilisee pour signer les sessions (JWT). Generez une valeur
# aleatoire longue et unique par installation, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_LONGUE
# Duree de validite d'une session (format "jsonwebtoken" : "12h", "7d", ...)
JWT_EXPIRES_IN=12h

# ----- Stockage local des donnees -----
# Dossier contenant products.json, movements.json, users.json.
# Sauvegardez regulierement ce dossier (copie simple suffit).
DATA_DIR=./data

# ----- Seuils de stock (grammes) pour les indicateurs Inventaire -----
STOCK_SEUIL_FAIBLE_G=100
STOCK_SEUIL_CRITIQUE_G=20

# ----- Securite -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
